<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite  parallel="methods" name="Suite">
  
  <groups>
  	<run>
  		<include name="ErrorHandling"></include>
  	</run>
  </groups>
  
  <test thread-count="5" name="Submit Order Test">
    <classes>
      <class name="UIAutomationTesting.TestCases.StandalonTest"/>
    </classes>
  </test>
  
  <test thread-count="5" name="Error Validtion Test">
    <classes>
      <class name="UIAutomationTesting.TestCases.ErrorValidtionTest"/>    
    </classes>
  </test>
</suite> 

    
      
      